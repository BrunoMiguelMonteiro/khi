{
  "name": "khi",
  "version": "1.3.0",
  "description": "A macOS app to export Kobo highlights to Markdown",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "version": "node scripts/sync-version.js && git add src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/tauri.conf.json",
    "release": "node scripts/release.js",
    "test:visual": "vite build && playwright test",
    "test:visual:update": "vite build && playwright test --update-snapshots=all"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-svelte": "^0.563.0",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.0-next.3",
    "@types/node": "^25.2.0",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "chalk": "^5.6.2",
    "enquirer": "^2.4.1",
    "execa": "^9.6.1",
    "jsdom": "^24.0.0",
    "ora": "^9.3.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
