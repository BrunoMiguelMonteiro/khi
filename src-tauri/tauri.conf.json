{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Khi",
  "version": "1.3.0",
  "identifier": "com.bruno.khi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Khi",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHEDIR/**",
          "$HOME/Library/Caches/com.bruno.khi/**",
          "$HOME/Library/Application Support/KoboHighlightsExporter/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
     "copyright": "Copyright © 2026 Bruno Monteiro. All rights reserved.",    
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    },
    "category": "Productivity",
    "shortDescription": "Export Kobo highlights to Markdown",
    "longDescription": "A macOS app to extract highlights from Kobo eReaders and export them to Markdown files."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0JCMDREREIxMzk3QzUKUldURmx4UGJUYkE3ZG4xWE5WZUd3bzB5alNKUUxCRDhHZ2pZQ3FoaXBzUGc2VEczQ0FZUmtZMEEK",
      "endpoints": [
        "https://github.com/BrunoMiguelMonteiro/khi/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
